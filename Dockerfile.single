FROM 01ai-registry.cn-shanghai.cr.aliyuncs.com/01-ai/mix/node:24-bookworm-slim AS build

WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build
RUN npx playwright install --with-deps chromium \
  && chmod -R a+rX /ms-playwright

FROM 01ai-registry.cn-shanghai.cr.aliyuncs.com/01-ai/mix/node:24-bookworm-slim AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=4310 \
    DATABASE_PATH=/data/opendots.sqlite \
    BROWSER_HOST=127.0.0.1 \
    BROWSER_PORT=4311 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && mkdir -p /data && chown node:node /data
COPY --from=build /app/dist ./dist
COPY --from=build /ms-playwright /ms-playwright
COPY deployment/start-single.sh /usr/local/bin/opendots-start
RUN chmod 0755 /usr/local/bin/opendots-start \
  && chown -R node:node /app /ms-playwright

USER node
EXPOSE 4310 4311
CMD ["/usr/local/bin/opendots-start"]
